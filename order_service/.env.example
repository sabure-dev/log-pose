# Local environment variables for order_service (when running on host Mac)
# Inside Docker Compose, docker-compose.yml environment variables take precedence.

DB_HOST=localhost
DB_PORT=5433
DB_USER=orders_user
DB_PASS=orders_password
DB_NAME=orders_db

RABBITMQ_URL=amqp://logpose_admin:logpose_password@localhost:5672/

PENDING_ORDER_TIMEOUT_SECONDS=900
